# Taps
tap 'buo/cask-upgrade', trusted: true # Cask upgrades
tap 'shivammathur/php', trusted: true # PHP versions
tap 'shivammathur/extensions', trusted: true # PHP extensions
tap 'symfony-cli/tap', trusted: true # Symfony CLI
tap 'anomalyco/tap', trusted: true # OpenCode

# Binaries
brew 'bash' # Latest Bash version
brew 'bat' # Cat clone with syntax highlighting and Git integration
brew 'coreutils' # Those that come with macOS are outdated
brew 'git' # Git version control system
brew 'go' # Go programming language
brew 'grep' # GNU grep
brew 'jq' # JSON parser
brew 'mas' # Tool to install Mac App updates
brew 'pkg-config' # https://github.com/driesvints/dotfiles/issues/20
brew 'rtk' # Rust Token Killer
brew 'nss' # Required for symfony cli local server
brew 'tree' # List directories in a tree structure

# Development
brew 'composer' # PHP dependency manager
brew 'pnpm' # Node package manager
brew 'starship' # Cross-shell prompt
brew 'symfony-cli/tap/symfony-cli' # Symfony CLI
brew 'tokei' # Displays statistics about your code
brew 'wget' # Retrieve files from the web
brew 'wrk' # HTTP benchmarking tool

# PHP versions
brew 'php' # PHP 8.5 from homebrew/core
brew 'shivammathur/extensions/amqp@8.5'
brew 'shivammathur/extensions/apcu@8.5'
brew 'shivammathur/extensions/grpc@8.5'
brew 'shivammathur/extensions/igbinary@8.5'
brew 'shivammathur/extensions/mongodb@8.5'
brew 'shivammathur/extensions/pcov@8.5'
brew 'shivammathur/extensions/protobuf@8.5'
brew 'shivammathur/extensions/phpredis@8.5'

# Apps
cask 'alfred' # Productivity app
cask 'appcleaner' # Uninstaller
cask 'beekeeper-studio' # Database GUI
cask 'bruno' # API manager
cask 'github' # GitHub desktop app
cask 'handy' # Text to speech
cask 'imageoptim' # Image optimization
cask 'insomnia' # API client
cask 'medis' # Redis GUI
cask 'openlens' # AWS GUI
cask 'orbstack' # Docker alternative
cask 'phpstorm' # PHPStorm IDE
cask 'spotify' # Music player
brew 'anomalyco/tap/opencode-v2' # OpenCode CLI
cask 't3-code' # AI code editor
cask 'warp' # Terminal
cask 'whatsapp' # WhatsApp

# Fonts
cask 'font-fira-code-nerd-font' # Fira Code Nerd Font
